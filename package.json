{
  "name": "postfetch",
  "version": "0.1.0",
  "description": "Tiny Bun server that turns social post URLs into downloadable media files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelokot/postfetch.git"
  },
  "bugs": {
    "url": "https://github.com/chelokot/postfetch/issues"
  },
  "homepage": "https://github.com/chelokot/postfetch#readme",
  "keywords": [
    "bun",
    "downloader",
    "instagram",
    "media",
    "tiktok",
    "youtube"
  ],
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "build:bin": "bun build --compile --minify --target=bun-linux-x64-baseline src/index.ts --outfile dist/postfetch",
    "check": "bun run typecheck && bun test",
    "container:build": "docker build -t postfetch:local .",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  }
}
