{
  "name": "postfetch",
  "version": "0.2.0",
  "private": true,
  "description": "Turn social post URLs into media files. A zero-dependency typed core, a superminimal showcase bun image, and deploy templates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelokot/postfetch.git"
  },
  "bugs": {
    "url": "https://github.com/chelokot/postfetch/issues"
  },
  "homepage": "https://github.com/chelokot/postfetch#readme",
  "keywords": [
    "bun",
    "downloader",
    "instagram",
    "linkedin",
    "media",
    "tiktok",
    "youtube"
  ],
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "templates/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "dev": "bun run --filter='@postfetch/server' dev",
    "start": "bun run --filter='@postfetch/server' start"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  }
}
