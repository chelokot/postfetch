{
  "name": "@postfetch/core",
  "version": "0.2.4",
  "description": "Zero-dependency typed core that turns Facebook, Instagram, Pinterest, Reddit, TikTok, X and YouTube post URLs into media files.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chelokot/postfetch.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/chelokot/postfetch/tree/main/packages/core#readme",
  "keywords": [
    "cobalt",
    "downloader",
    "facebook",
    "instagram",
    "media",
    "pinterest",
    "reddit",
    "tiktok",
    "twitter",
    "youtube",
    "zero-dependency"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
